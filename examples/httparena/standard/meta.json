{
  "display_name": "dusty",
  "language": "Zig",
  "type": "emerging",
  "mode": "standard",
  "completeness": {
    "routing": true,
    "middleware": true,
    "request": true,
    "response": true
  },
  "engine": "zio",
  "description": "Dusty HTTP framework on the zio async runtime (io_uring where available, epoll fallback). Router with params/wildcards, JSON, gzip, WebSocket. Standard configuration, no tuning.",
  "repo": "https://github.com/lalinsky/dusty",
  "enabled": true,
  "tests": [
    "baseline", "latency-1m", "latency-10k", "latency-500k-8cpu",
    "pipelined",
    "limited-conn",
    "async",
    "json-comp", "json-tls", "static-tls",
    "8gbit",
    "async-db",
    "fortunes",
    "echo-ws", "echo-ws-pipeline", "echo-ws-limited"
  ],
  "maintainers": [
    "lalinsky"
  ]
}
