pub const Fortune = struct {
    id: i32,
    message: []const u8,
};

pub templ Layout(title: []const u8) {
    <!DOCTYPE html>
    <html>
        <head><title>{title}</title></head>
        <body>
            @children
        </body>
    </html>
}

pub templ FortunesPage(fortunes: []const Fortune) {
    @Layout("Fortunes") {
        <table>
            <tr><th>id</th><th>message</th></tr>
            for (fortunes) |fortune| {
                <tr><td>{fortune.id}</td><td>{fortune.message}</td></tr>
            }
        </table>
    }
}
